{
  "name": "Records, cross-app reads, contributions, locks and wipe",
  "setup": {
    "now": "2026-11-02T14:00:00Z",
    "household": {
      "zone": "America/New_York",
      "members": [
        {
          "id": "dana",
          "name": "Dana",
          "role": "owner",
          "may_approve": [
            "*"
          ],
          "devices": [
            "dana-phone"
          ]
        },
        {
          "id": "sam",
          "name": "Sam",
          "role": "adult",
          "may_approve": [
            "mail.send",
            "calendar.write"
          ],
          "devices": [
            "sam-phone"
          ]
        },
        {
          "id": "maya",
          "name": "Maya",
          "role": "child"
        }
      ],
      "guardians": {
        "maya": [
          "dana"
        ]
      }
    },
    "connections": [
      {
        "handle": "household-mail",
        "kind": "mail",
        "account": "family@example.test"
      },
      {
        "handle": "claude",
        "kind": "provider"
      }
    ]
  },
  "steps": [
    {
      "call": "install/v0.3/install",
      "body": {
        "caller": {
          "shell": "dana",
          "device": "dana-phone"
        },
        "manifest": {
          "app": "lists",
          "name": "Lists",
          "version": "0.1.0",
          "surfaces": {
            "install": "0.3",
            "activities": "0.2",
            "grants": "0.2",
            "proposals": "0.3",
            "ledger": "0.1",
            "records": "0.3",
            "egress": "0.2",
            "members": "0.2",
            "schedules": "0.3",
            "household": "0.3"
          },
          "record_types": [
            {
              "name": "item"
            }
          ],
          "routines": [
            {
              "name": "groceries",
              "concurrency_key": "groceries"
            }
          ],
          "operations": [
            {
              "operation": "mail.send",
              "adapter": "mail",
              "object": "mail:household-mail",
              "grant": "one_time"
            }
          ],
          "notifications": {
            "kinds": [
              "ready"
            ],
            "per_day": 1
          }
        }
      }
    },
    {
      "call": "install/v0.3/install",
      "body": {
        "caller": {
          "shell": "dana",
          "device": "dana-phone"
        },
        "manifest": {
          "app": "the-week",
          "name": "The week",
          "version": "0.1.0",
          "surfaces": {
            "install": "0.3",
            "activities": "0.2",
            "grants": "0.2",
            "proposals": "0.3",
            "ledger": "0.1",
            "records": "0.3",
            "egress": "0.2",
            "members": "0.2",
            "schedules": "0.3",
            "household": "0.3"
          },
          "record_types": [
            {
              "name": "week_note"
            }
          ],
          "routines": [
            {
              "name": "sunday",
              "trigger": "schedule"
            }
          ],
          "operations": [],
          "read_scopes": [
            {
              "app": "lists",
              "record_types": [
                "item"
              ]
            }
          ]
        }
      }
    },
    {
      "call": "install/v0.3/switch_on",
      "body": {
        "caller": {
          "shell": "sam",
          "device": "sam-phone"
        },
        "app": "lists"
      }
    },
    {
      "call": "install/v0.3/switch_on",
      "body": {
        "caller": {
          "shell": "dana",
          "device": "dana-phone"
        },
        "app": "the-week"
      }
    },
    {
      "call": "records/v0.3/write",
      "body": {
        "caller": {
          "app": "lists",
          "member": "sam"
        },
        "type": "item",
        "content": {
          "text": "eggs"
        },
        "client_key": "k1",
        "provenance": {
          "source": "sam",
          "trust": "member"
        },
        "audience": "household"
      },
      "save": {
        "item": "object"
      }
    },
    {
      "call": "records/v0.3/write",
      "body": {
        "caller": {
          "app": "lists",
          "member": "sam"
        },
        "type": "item",
        "content": {
          "text": "eggs"
        },
        "client_key": "k1",
        "provenance": {
          "source": "sam",
          "trust": "member"
        },
        "audience": "household"
      },
      "expect": {
        "ok": {
          "object": "${item}",
          "repeat": true
        }
      }
    },
    {
      "call": "records/v0.3/write",
      "body": {
        "caller": {
          "app": "lists",
          "member": "sam"
        },
        "type": "recipe",
        "content": {},
        "audience": "household"
      },
      "expect": {
        "refused": "record_type_undeclared"
      }
    },
    {
      "call": "records/v0.3/write",
      "body": {
        "caller": {
          "app": "lists",
          "member": "sam"
        },
        "type": "item",
        "content": {},
        "provenance": {
          "trust": "service"
        },
        "audience": "household"
      },
      "expect": {
        "refused": "trust_label_not_allowed"
      }
    },
    {
      "call": "records/v0.3/read",
      "body": {
        "caller": {
          "app": "the-week",
          "member": "dana"
        },
        "object": "${item}"
      },
      "expect": {
        "ok": {
          "records": [
            {
              "content": {
                "text": "eggs"
              }
            }
          ]
        }
      }
    },
    {
      "call": "records/v0.3/read",
      "body": {
        "caller": {
          "app": "lists",
          "member": "dana"
        },
        "type": "week_note"
      },
      "expect": {
        "ok": {
          "records": []
        }
      }
    },
    {
      "call": "activities/v0.2/open",
      "body": {
        "caller": {
          "app": "lists",
          "member": "sam"
        },
        "routine": "groceries",
        "audience": [
          "sam"
        ]
      },
      "save": {
        "a1": "activity"
      }
    },
    {
      "call": "records/v0.3/write",
      "body": {
        "caller": {
          "routine": "${a1}"
        },
        "type": "item",
        "content": {
          "text": "milk"
        },
        "audience": "household"
      },
      "expect": {
        "refused": "audience_too_wide"
      }
    },
    {
      "call": "records/v0.3/write",
      "body": {
        "caller": {
          "routine": "${a1}"
        },
        "type": "item",
        "content": {
          "text": "milk"
        },
        "audience": {
          "members": [
            "sam"
          ]
        }
      },
      "save": {
        "milk": "object"
      }
    },
    {
      "call": "records/v0.3/promote",
      "body": {
        "caller": {
          "app": "lists",
          "member": "sam"
        },
        "object": "${milk}",
        "audience": "household"
      }
    },
    {
      "call": "records/v0.3/delete",
      "body": {
        "caller": {
          "app": "the-week",
          "member": "dana"
        },
        "object": "${milk}"
      },
      "expect": {
        "refused": "not_writer_or_owner"
      }
    },
    {
      "call": "records/v0.3/delete",
      "body": {
        "caller": {
          "shell": "dana",
          "device": "dana-phone"
        },
        "object": "${milk}"
      }
    },
    {
      "call": "records/v0.3/read",
      "body": {
        "caller": {
          "shell": "dana",
          "device": "dana-phone"
        },
        "object": "${milk}"
      },
      "expect": {
        "ok": {
          "records": [
            {
              "deleted": true,
              "content": null
            }
          ]
        }
      }
    },
    {
      "call": "household/v0.3/contribute",
      "body": {
        "caller": {
          "app": "lists",
          "member": "sam"
        },
        "kind": "settings_panel",
        "content": {
          "title": "Lists"
        }
      }
    },
    {
      "call": "household/v0.3/contribute",
      "body": {
        "caller": {
          "app": "lists",
          "member": "sam"
        },
        "kind": "settings_panel",
        "content": {
          "title": "Again"
        }
      },
      "expect": {
        "refused": "second_settings_panel"
      }
    },
    {
      "call": "household/v0.3/contribute",
      "body": {
        "caller": {
          "app": "lists",
          "member": "sam"
        },
        "kind": "question",
        "content": {
          "operation": "mail.send"
        }
      },
      "expect": {
        "refused": "needs_proposal"
      }
    },
    {
      "call": "household/v0.3/contribute",
      "body": {
        "caller": {
          "app": "lists",
          "member": "sam"
        },
        "kind": "question",
        "content": {
          "text": "Oat milk or regular?"
        },
        "audience": [
          "sam"
        ]
      },
      "save": {
        "q": "item"
      }
    },
    {
      "call": "household/v0.3/answer",
      "body": {
        "caller": {
          "shell": "sam",
          "device": "sam-phone"
        },
        "item": "${q}",
        "response": "oat"
      },
      "save": {
        "answer": "record"
      }
    },
    {
      "call": "egress/v0.2/lock_category",
      "body": {
        "caller": {
          "shell": "sam",
          "device": "sam-phone"
        },
        "category": "children"
      },
      "expect": {
        "refused": "not_owner"
      }
    },
    {
      "call": "egress/v0.2/lock_category",
      "body": {
        "caller": {
          "shell": "dana",
          "device": "dana-phone"
        },
        "category": "children"
      }
    },
    {
      "call": "egress/v0.2/loosen",
      "body": {
        "caller": {
          "shell": "sam",
          "device": "sam-phone"
        },
        "activity": "${a1}",
        "categories": [
          "children"
        ]
      },
      "expect": {
        "refused": "category_locked"
      }
    },
    {
      "call": "members/v0.2/set_guardians",
      "body": {
        "caller": {
          "shell": "dana",
          "device": "dana-phone"
        },
        "child": "maya",
        "guardians": [
          "dana",
          "sam"
        ]
      }
    },
    {
      "call": "household/v0.3/wipe",
      "body": {
        "caller": {
          "shell": "sam",
          "device": "sam-phone"
        }
      },
      "expect": {
        "refused": "not_owner"
      }
    },
    {
      "call": "household/v0.3/wipe",
      "body": {
        "caller": {
          "shell": "dana",
          "device": "dana-phone"
        }
      }
    }
  ],
  "about": "Ends with a wipe, the one action that leaves no ledger line, so the forbidden entry {} (which matches any line) checks the ledger is empty.",
  "forbid_ledger": [
    {}
  ]
}
