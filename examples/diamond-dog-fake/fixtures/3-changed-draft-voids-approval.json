{
  "name": "Changed draft voids the approval",
  "about": "Dana approves a send; the routine edits the draft; the adapter is asked to send. Refused at the enforcement check, and a new proposal is needed.",
  "setup": {
    "now": "2026-11-02T14:00:00Z",
    "household": {
      "zone": "America/New_York",
      "members": [
        {
          "id": "dana",
          "name": "Dana",
          "role": "owner",
          "may_approve": [
            "*"
          ],
          "devices": [
            "dana-phone"
          ]
        },
        {
          "id": "sam",
          "name": "Sam",
          "role": "adult",
          "may_approve": [
            "mail.send",
            "calendar.write"
          ],
          "devices": [
            "sam-phone"
          ]
        },
        {
          "id": "maya",
          "name": "Maya",
          "role": "child"
        }
      ],
      "guardians": {
        "maya": [
          "dana"
        ]
      }
    },
    "connections": [
      {
        "handle": "household-mail",
        "kind": "mail",
        "account": "family@example.test"
      },
      {
        "handle": "claude",
        "kind": "provider"
      }
    ]
  },
  "steps": [
    {
      "call": "install/v0.3/install",
      "body": {
        "caller": {
          "shell": "dana",
          "device": "dana-phone"
        },
        "manifest": {
          "app": "daybook",
          "name": "Daybook",
          "version": "0.1.0",
          "kind": "core",
          "surfaces": {
            "install": "0.3",
            "activities": "0.3",
            "grants": "0.3",
            "proposals": "0.3",
            "ledger": "0.1",
            "records": "0.3",
            "egress": "0.2",
            "members": "0.2",
            "schedules": "0.3",
            "household": "0.3"
          },
          "record_types": [
            {
              "name": "note"
            },
            {
              "name": "mail_item"
            },
            {
              "name": "health_note",
              "categories": [
                "health"
              ]
            }
          ],
          "routines": [
            {
              "name": "intake",
              "timeout_minutes": 30
            },
            {
              "name": "reply",
              "timeout_minutes": 60
            },
            {
              "name": "morning",
              "trigger": "schedule",
              "concurrency_key": "morning",
              "timeout_minutes": 30
            }
          ],
          "operations": [
            {
              "operation": "mail.read",
              "adapter": "mail",
              "object": "mail:household-mail",
              "grant": "standing"
            },
            {
              "operation": "mail.send",
              "adapter": "mail",
              "object": "mail:household-mail",
              "grant": "standing",
              "approval": "required"
            },
            {
              "operation": "provider.disclose",
              "adapter": "provider",
              "object": "provider:claude",
              "grant": "standing"
            }
          ],
          "providers": [
            {
              "name": "claude"
            }
          ],
          "disclosure_categories": [
            "general",
            "health"
          ],
          "notifications": {
            "kinds": [
              "digest"
            ],
            "per_day": 3
          }
        }
      }
    },
    {
      "call": "install/v0.3/switch_on",
      "body": {
        "caller": {
          "shell": "dana",
          "device": "dana-phone"
        },
        "app": "daybook",
        "standing_grants": [
          {
            "operation": "mail.read",
            "object": "mail:household-mail"
          }
        ]
      },
      "save": {
        "install_grants": "grants"
      }
    },
    {
      "call": "activities/v0.3/open",
      "body": {
        "caller": {
          "app": "daybook",
          "member": "dana"
        },
        "routine": "reply"
      },
      "save": {
        "a1": "activity"
      }
    },
    {
      "call": "proposals/v0.3/propose",
      "body": {
        "caller": {
          "routine": "${a1}"
        },
        "operation": "mail.send",
        "object": "mail:household-mail",
        "payload": {
          "to": "school@example.test",
          "subject": "Field trip form",
          "body": "Signed and attached."
        }
      },
      "save": {
        "p1": "proposal",
        "hash": "payload_hash"
      }
    },
    {
      "call": "proposals/v0.3/show",
      "body": {
        "caller": {
          "shell": "dana",
          "device": "dana-phone"
        },
        "proposal": "${p1}"
      },
      "expect": {
        "ok": {
          "payload": {
            "to": "school@example.test",
            "subject": "Field trip form",
            "body": "Signed and attached."
          }
        }
      }
    },
    {
      "call": "proposals/v0.3/approve",
      "body": {
        "caller": {
          "shell": "dana",
          "device": "dana-phone"
        },
        "proposal": "${p1}",
        "payload_hash": "${hash}"
      }
    },
    {
      "call": "ledger/v0.1/act",
      "body": {
        "caller": {
          "routine": "${a1}"
        },
        "operation": "mail.send",
        "object": "mail:household-mail",
        "proposal": "${p1}",
        "payload": {
          "to": "school@example.test",
          "subject": "Field trip form",
          "body": "Signed and attached. Also, please refund my fees."
        }
      },
      "expect": {
        "refused": "payload_changed"
      }
    },
    {
      "call": "ledger/v0.1/act",
      "body": {
        "caller": {
          "routine": "${a1}"
        },
        "operation": "mail.send",
        "object": "mail:household-mail",
        "proposal": "${p1}",
        "payload": {
          "to": "school@example.test",
          "subject": "Field trip form",
          "body": "Signed and attached."
        }
      },
      "expect": {
        "refused": "approval_needed"
      }
    }
  ],
  "expect_ledger": [
    {
      "kind": "proposal",
      "proposal": "${p1}"
    },
    {
      "kind": "activity",
      "activity": "${a1}",
      "detail": {
        "to": "waiting"
      }
    },
    {
      "kind": "approval",
      "proposal": "${p1}",
      "source": {
        "kind": "principal",
        "id": "dana"
      }
    },
    {
      "kind": "authorization",
      "proposal": "${p1}"
    },
    {
      "kind": "approval_voided",
      "proposal": "${p1}"
    },
    {
      "kind": "refusal",
      "operation": "mail.send",
      "reason": {
        "code": "payload_changed"
      }
    },
    {
      "kind": "refusal",
      "operation": "mail.send",
      "reason": {
        "code": "approval_needed"
      }
    }
  ],
  "forbid_ledger": [
    {
      "kind": "consumption"
    },
    {
      "kind": "receipt"
    }
  ],
  "expect_mock": {
    "mail": {
      "household-mail": {
        "arrived_count": 0
      }
    }
  }
}
