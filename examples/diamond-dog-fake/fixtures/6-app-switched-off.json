{
  "name": "App switched off",
  "about": "Dana switches Daybook off with a scheduled run due. No process, no egress, and the missed tick is journaled.",
  "setup": {
    "now": "2026-11-02T14:00:00Z",
    "household": {
      "zone": "America/New_York",
      "members": [
        {
          "id": "dana",
          "name": "Dana",
          "role": "owner",
          "may_approve": [
            "*"
          ],
          "devices": [
            "dana-phone"
          ]
        },
        {
          "id": "sam",
          "name": "Sam",
          "role": "adult",
          "may_approve": [
            "mail.send",
            "calendar.write"
          ],
          "devices": [
            "sam-phone"
          ]
        },
        {
          "id": "maya",
          "name": "Maya",
          "role": "child"
        }
      ],
      "guardians": {
        "maya": [
          "dana"
        ]
      }
    },
    "connections": [
      {
        "handle": "household-mail",
        "kind": "mail",
        "account": "family@example.test"
      },
      {
        "handle": "claude",
        "kind": "provider"
      }
    ]
  },
  "steps": [
    {
      "call": "install/v0.3/install",
      "body": {
        "caller": {
          "shell": "dana",
          "device": "dana-phone"
        },
        "manifest": {
          "app": "daybook",
          "name": "Daybook",
          "version": "0.1.0",
          "kind": "core",
          "surfaces": {
            "install": "0.3",
            "activities": "0.2",
            "grants": "0.2",
            "proposals": "0.3",
            "ledger": "0.1",
            "records": "0.3",
            "egress": "0.2",
            "members": "0.2",
            "schedules": "0.3",
            "household": "0.3"
          },
          "record_types": [
            {
              "name": "note"
            },
            {
              "name": "mail_item"
            },
            {
              "name": "health_note",
              "categories": [
                "health"
              ]
            }
          ],
          "routines": [
            {
              "name": "intake",
              "timeout_minutes": 30
            },
            {
              "name": "reply",
              "timeout_minutes": 60
            },
            {
              "name": "morning",
              "trigger": "schedule",
              "concurrency_key": "morning",
              "timeout_minutes": 30
            }
          ],
          "operations": [
            {
              "operation": "mail.read",
              "adapter": "mail",
              "object": "mail:household-mail",
              "grant": "standing"
            },
            {
              "operation": "mail.send",
              "adapter": "mail",
              "object": "mail:household-mail",
              "grant": "standing",
              "approval": "required"
            },
            {
              "operation": "provider.disclose",
              "adapter": "provider",
              "object": "provider:claude",
              "grant": "standing"
            }
          ],
          "providers": [
            {
              "name": "claude"
            }
          ],
          "disclosure_categories": [
            "general",
            "health"
          ],
          "notifications": {
            "kinds": [
              "digest"
            ],
            "per_day": 3
          }
        }
      }
    },
    {
      "call": "install/v0.3/switch_on",
      "body": {
        "caller": {
          "shell": "dana",
          "device": "dana-phone"
        },
        "app": "daybook",
        "standing_grants": [
          {
            "operation": "mail.read",
            "object": "mail:household-mail"
          }
        ]
      },
      "save": {
        "install_grants": "grants"
      }
    },
    {
      "call": "schedules/v0.3/schedule",
      "body": {
        "caller": {
          "app": "daybook",
          "member": "dana"
        },
        "routine": "morning",
        "at": "07:00",
        "cadence": "daily"
      },
      "save": {
        "s1": "schedule"
      }
    },
    {
      "call": "install/v0.3/switch_off",
      "body": {
        "caller": {
          "shell": "dana",
          "device": "dana-phone"
        },
        "app": "daybook"
      }
    },
    {
      "control": "clock/advance",
      "body": {
        "days": 1
      }
    },
    {
      "call": "activities/v0.2/open",
      "body": {
        "caller": {
          "app": "daybook",
          "member": "dana"
        },
        "routine": "intake"
      },
      "expect": {
        "refused": "app_off"
      }
    },
    {
      "call": "install/v0.3/switch_on",
      "body": {
        "caller": {
          "shell": "dana",
          "device": "dana-phone"
        },
        "app": "daybook"
      },
      "expect": {
        "ok": {
          "held_for_confirmation": [
            "${install_grants.0}"
          ]
        }
      }
    }
  ],
  "expect_ledger": [
    {
      "kind": "switch_off",
      "app": "daybook",
      "source": {
        "kind": "principal",
        "id": "dana"
      }
    },
    {
      "kind": "grant_held",
      "grant": "${install_grants.0}"
    },
    {
      "kind": "tick",
      "app": "daybook",
      "detail": {
        "schedule": "${s1}",
        "ran": false
      }
    },
    {
      "kind": "refusal",
      "reason": {
        "code": "app_off"
      }
    }
  ],
  "forbid_ledger": [
    {
      "kind": "tick",
      "detail": {
        "ran": true
      }
    },
    {
      "kind": "read"
    },
    {
      "kind": "fetch"
    },
    {
      "kind": "consumption"
    }
  ],
  "expect_mock": {
    "fetch_count": 0,
    "mail": {
      "household-mail": {
        "arrived_count": 0
      }
    }
  }
}
