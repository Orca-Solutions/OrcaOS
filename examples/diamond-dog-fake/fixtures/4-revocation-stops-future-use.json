{
  "name": "Revocation stops future use",
  "about": "Dana revokes the standing mailbox grant mid-activity. The next read is refused, the activity goes Suspended, and the read already made stays in the ledger.",
  "setup": {
    "now": "2026-11-02T14:00:00Z",
    "household": {
      "zone": "America/New_York",
      "members": [
        {
          "id": "dana",
          "name": "Dana",
          "role": "owner",
          "may_approve": [
            "*"
          ],
          "devices": [
            "dana-phone"
          ]
        },
        {
          "id": "sam",
          "name": "Sam",
          "role": "adult",
          "may_approve": [
            "mail.send",
            "calendar.write"
          ],
          "devices": [
            "sam-phone"
          ]
        },
        {
          "id": "maya",
          "name": "Maya",
          "role": "child"
        }
      ],
      "guardians": {
        "maya": [
          "dana"
        ]
      }
    },
    "connections": [
      {
        "handle": "household-mail",
        "kind": "mail",
        "account": "family@example.test"
      },
      {
        "handle": "claude",
        "kind": "provider"
      }
    ],
    "mail": [
      {
        "handle": "household-mail",
        "from": "school@example.test",
        "subject": "Field trip",
        "body": "Form attached."
      }
    ]
  },
  "steps": [
    {
      "call": "install/v0.3/install",
      "body": {
        "caller": {
          "shell": "dana",
          "device": "dana-phone"
        },
        "manifest": {
          "app": "daybook",
          "name": "Daybook",
          "version": "0.1.0",
          "kind": "core",
          "surfaces": {
            "install": "0.3",
            "activities": "0.2",
            "grants": "0.2",
            "proposals": "0.3",
            "ledger": "0.1",
            "records": "0.3",
            "egress": "0.2",
            "members": "0.2",
            "schedules": "0.3",
            "household": "0.3"
          },
          "record_types": [
            {
              "name": "note"
            },
            {
              "name": "mail_item"
            },
            {
              "name": "health_note",
              "categories": [
                "health"
              ]
            }
          ],
          "routines": [
            {
              "name": "intake",
              "timeout_minutes": 30
            },
            {
              "name": "reply",
              "timeout_minutes": 60
            },
            {
              "name": "morning",
              "trigger": "schedule",
              "concurrency_key": "morning",
              "timeout_minutes": 30
            }
          ],
          "operations": [
            {
              "operation": "mail.read",
              "adapter": "mail",
              "object": "mail:household-mail",
              "grant": "standing"
            },
            {
              "operation": "mail.send",
              "adapter": "mail",
              "object": "mail:household-mail",
              "grant": "standing",
              "approval": "required"
            },
            {
              "operation": "provider.disclose",
              "adapter": "provider",
              "object": "provider:claude",
              "grant": "standing"
            }
          ],
          "providers": [
            {
              "name": "claude"
            }
          ],
          "disclosure_categories": [
            "general",
            "health"
          ],
          "notifications": {
            "kinds": [
              "digest"
            ],
            "per_day": 3
          }
        }
      }
    },
    {
      "call": "install/v0.3/switch_on",
      "body": {
        "caller": {
          "shell": "dana",
          "device": "dana-phone"
        },
        "app": "daybook",
        "standing_grants": [
          {
            "operation": "mail.read",
            "object": "mail:household-mail"
          }
        ]
      },
      "save": {
        "install_grants": "grants"
      }
    },
    {
      "call": "activities/v0.2/open",
      "body": {
        "caller": {
          "app": "daybook",
          "member": "dana"
        },
        "routine": "intake"
      },
      "save": {
        "a1": "activity"
      }
    },
    {
      "call": "grants/v0.2/use",
      "body": {
        "caller": {
          "routine": "${a1}"
        },
        "operation": "mail.read",
        "object": "mail:household-mail"
      }
    },
    {
      "call": "grants/v0.2/revoke",
      "body": {
        "caller": {
          "shell": "dana",
          "device": "dana-phone"
        },
        "grant": "${install_grants.0}"
      }
    },
    {
      "call": "grants/v0.2/use",
      "body": {
        "caller": {
          "routine": "${a1}"
        },
        "operation": "mail.read",
        "object": "mail:household-mail"
      },
      "expect": {
        "refused": "grant_revoked"
      }
    },
    {
      "call": "activities/v0.2/read_state",
      "body": {
        "caller": {
          "shell": "dana",
          "device": "dana-phone"
        },
        "activity": "${a1}"
      },
      "expect": {
        "ok": {
          "state": "suspended"
        }
      }
    }
  ],
  "expect_ledger": [
    {
      "kind": "grant",
      "holder": "activity:${a1}",
      "operation": "mail.read",
      "detail": {
        "derived_from": "${install_grants.0}"
      }
    },
    {
      "kind": "read",
      "activity": "${a1}",
      "operation": "mail.read"
    },
    {
      "kind": "revocation",
      "grant": "${install_grants.0}",
      "source": {
        "kind": "principal",
        "id": "dana"
      }
    },
    {
      "kind": "revocation",
      "holder": "activity:${a1}"
    },
    {
      "kind": "activity",
      "activity": "${a1}",
      "detail": {
        "to": "suspended"
      }
    },
    {
      "kind": "refusal",
      "activity": "${a1}",
      "operation": "mail.read",
      "reason": {
        "code": "grant_revoked"
      }
    }
  ]
}
