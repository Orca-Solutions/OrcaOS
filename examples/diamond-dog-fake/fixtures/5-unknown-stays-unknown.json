{
  "name": "Unknown stays unknown",
  "about": "The mock mail service accepts the request and never acknowledges. The receipt says unknown; a later status check reconciles it; nothing is re-sent.",
  "setup": {
    "now": "2026-11-02T14:00:00Z",
    "household": {
      "zone": "America/New_York",
      "members": [
        {
          "id": "dana",
          "name": "Dana",
          "role": "owner",
          "may_approve": [
            "*"
          ],
          "devices": [
            "dana-phone"
          ]
        },
        {
          "id": "sam",
          "name": "Sam",
          "role": "adult",
          "may_approve": [
            "mail.send",
            "calendar.write"
          ],
          "devices": [
            "sam-phone"
          ]
        },
        {
          "id": "maya",
          "name": "Maya",
          "role": "child"
        }
      ],
      "guardians": {
        "maya": [
          "dana"
        ]
      }
    },
    "connections": [
      {
        "handle": "household-mail",
        "kind": "mail",
        "account": "family@example.test"
      },
      {
        "handle": "claude",
        "kind": "provider"
      }
    ]
  },
  "steps": [
    {
      "call": "install/v0.3/install",
      "body": {
        "caller": {
          "shell": "dana",
          "device": "dana-phone"
        },
        "manifest": {
          "app": "daybook",
          "name": "Daybook",
          "version": "0.1.0",
          "kind": "core",
          "surfaces": {
            "install": "0.3",
            "activities": "0.3",
            "grants": "0.3",
            "proposals": "0.3",
            "ledger": "0.1",
            "records": "0.3",
            "egress": "0.3",
            "members": "0.2",
            "schedules": "0.3",
            "household": "0.3"
          },
          "record_types": [
            {
              "name": "note"
            },
            {
              "name": "mail_item"
            },
            {
              "name": "health_note",
              "categories": [
                "health"
              ]
            }
          ],
          "routines": [
            {
              "name": "intake",
              "timeout_minutes": 30
            },
            {
              "name": "reply",
              "timeout_minutes": 60
            },
            {
              "name": "morning",
              "trigger": "schedule",
              "concurrency_key": "morning",
              "timeout_minutes": 30
            }
          ],
          "operations": [
            {
              "operation": "mail.read",
              "adapter": "mail",
              "object": "mail:household-mail",
              "grant": "standing"
            },
            {
              "operation": "mail.send",
              "adapter": "mail",
              "object": "mail:household-mail",
              "grant": "standing",
              "approval": "required"
            },
            {
              "operation": "provider.disclose",
              "adapter": "provider",
              "object": "provider:claude",
              "grant": "standing"
            }
          ],
          "providers": [
            {
              "name": "claude"
            }
          ],
          "disclosure_categories": [
            "general",
            "health"
          ],
          "notifications": {
            "kinds": [
              "digest"
            ],
            "per_day": 3
          }
        }
      }
    },
    {
      "call": "install/v0.3/switch_on",
      "body": {
        "caller": {
          "shell": "dana",
          "device": "dana-phone"
        },
        "app": "daybook",
        "standing_grants": [
          {
            "operation": "mail.read",
            "object": "mail:household-mail"
          }
        ]
      },
      "save": {
        "install_grants": "grants"
      }
    },
    {
      "call": "activities/v0.3/open",
      "body": {
        "caller": {
          "app": "daybook",
          "member": "dana"
        },
        "routine": "reply"
      },
      "save": {
        "a1": "activity"
      }
    },
    {
      "call": "proposals/v0.3/propose",
      "body": {
        "caller": {
          "routine": "${a1}"
        },
        "operation": "mail.send",
        "object": "mail:household-mail",
        "payload": {
          "to": "school@example.test",
          "subject": "Field trip form",
          "body": "Signed and attached."
        }
      },
      "save": {
        "p1": "proposal",
        "hash": "payload_hash"
      }
    },
    {
      "call": "proposals/v0.3/approve",
      "body": {
        "caller": {
          "shell": "dana",
          "device": "dana-phone"
        },
        "proposal": "${p1}",
        "payload_hash": "${hash}"
      }
    },
    {
      "control": "mail/fault",
      "body": {
        "handle": "household-mail",
        "fault": "never_acknowledge"
      }
    },
    {
      "call": "ledger/v0.1/act",
      "body": {
        "caller": {
          "routine": "${a1}"
        },
        "operation": "mail.send",
        "object": "mail:household-mail",
        "proposal": "${p1}",
        "payload": {
          "to": "school@example.test",
          "subject": "Field trip form",
          "body": "Signed and attached."
        }
      },
      "expect": {
        "ok": {
          "outcome": {
            "state": "unknown"
          }
        }
      },
      "save": {
        "rid": "request_id"
      }
    },
    {
      "call": "ledger/v0.1/act",
      "body": {
        "caller": {
          "routine": "${a1}"
        },
        "operation": "mail.send",
        "object": "mail:household-mail",
        "proposal": "${p1}",
        "payload": {
          "to": "school@example.test",
          "subject": "Field trip form",
          "body": "Signed and attached."
        }
      },
      "expect": {
        "refused": "approval_needed"
      }
    },
    {
      "control": "clock/advance",
      "body": {
        "minutes": 10
      }
    },
    {
      "call": "ledger/v0.1/reconcile",
      "body": {
        "caller": {
          "routine": "${a1}"
        },
        "request_id": "${rid}"
      },
      "expect": {
        "ok": {
          "outcome": {
            "state": "reconciled",
            "to": {
              "state": "acknowledged"
            }
          }
        }
      }
    }
  ],
  "expect_ledger": [
    {
      "kind": "consumption",
      "request_id": "${rid}"
    },
    {
      "kind": "receipt",
      "request_id": "${rid}",
      "outcome": {
        "state": "unknown"
      },
      "authority": {
        "approval": "${p1}",
        "member": "dana"
      }
    },
    {
      "kind": "refusal",
      "reason": {
        "code": "approval_needed"
      }
    },
    {
      "kind": "reconciliation",
      "request_id": "${rid}",
      "source": {
        "kind": "external"
      },
      "outcome": {
        "state": "reconciled",
        "to": {
          "state": "acknowledged"
        }
      }
    }
  ],
  "expect_mock": {
    "mail": {
      "household-mail": {
        "arrived_count": 1,
        "delivered_count": 1
      }
    }
  }
}
