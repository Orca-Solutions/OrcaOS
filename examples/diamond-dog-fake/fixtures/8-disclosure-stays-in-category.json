{
  "name": "Disclosure stays in category",
  "about": "A routine sends a mail carrying a health note to the model provider. Refused until Dana loosens health for this matter; then the receipt names what went, to whom, under which grant.",
  "setup": {
    "now": "2026-11-02T14:00:00Z",
    "household": {
      "zone": "America/New_York",
      "members": [
        {
          "id": "dana",
          "name": "Dana",
          "role": "owner",
          "may_approve": [
            "*"
          ],
          "devices": [
            "dana-phone"
          ]
        },
        {
          "id": "sam",
          "name": "Sam",
          "role": "adult",
          "may_approve": [
            "mail.send",
            "calendar.write"
          ],
          "devices": [
            "sam-phone"
          ]
        },
        {
          "id": "maya",
          "name": "Maya",
          "role": "child"
        }
      ],
      "guardians": {
        "maya": [
          "dana"
        ]
      }
    },
    "connections": [
      {
        "handle": "household-mail",
        "kind": "mail",
        "account": "family@example.test"
      },
      {
        "handle": "claude",
        "kind": "provider"
      }
    ]
  },
  "steps": [
    {
      "call": "install/v0.3/install",
      "body": {
        "caller": {
          "shell": "dana",
          "device": "dana-phone"
        },
        "manifest": {
          "app": "daybook",
          "name": "Daybook",
          "version": "0.1.0",
          "kind": "core",
          "surfaces": {
            "install": "0.3",
            "activities": "0.2",
            "grants": "0.2",
            "proposals": "0.3",
            "ledger": "0.1",
            "records": "0.3",
            "egress": "0.2",
            "members": "0.2",
            "schedules": "0.3",
            "household": "0.3"
          },
          "record_types": [
            {
              "name": "note"
            },
            {
              "name": "mail_item"
            },
            {
              "name": "health_note",
              "categories": [
                "health"
              ]
            }
          ],
          "routines": [
            {
              "name": "intake",
              "timeout_minutes": 30
            },
            {
              "name": "reply",
              "timeout_minutes": 60
            },
            {
              "name": "morning",
              "trigger": "schedule",
              "concurrency_key": "morning",
              "timeout_minutes": 30
            }
          ],
          "operations": [
            {
              "operation": "mail.read",
              "adapter": "mail",
              "object": "mail:household-mail",
              "grant": "standing"
            },
            {
              "operation": "mail.send",
              "adapter": "mail",
              "object": "mail:household-mail",
              "grant": "standing",
              "approval": "required"
            },
            {
              "operation": "provider.disclose",
              "adapter": "provider",
              "object": "provider:claude",
              "grant": "standing"
            }
          ],
          "providers": [
            {
              "name": "claude"
            }
          ],
          "disclosure_categories": [
            "general",
            "health"
          ],
          "notifications": {
            "kinds": [
              "digest"
            ],
            "per_day": 3
          }
        }
      }
    },
    {
      "call": "install/v0.3/switch_on",
      "body": {
        "caller": {
          "shell": "dana",
          "device": "dana-phone"
        },
        "app": "daybook",
        "standing_grants": [
          {
            "operation": "mail.read",
            "object": "mail:household-mail"
          },
          {
            "operation": "provider.disclose",
            "object": "provider:claude"
          }
        ]
      },
      "save": {
        "install_grants": "grants"
      }
    },
    {
      "call": "activities/v0.2/open",
      "body": {
        "caller": {
          "app": "daybook",
          "member": "dana"
        },
        "routine": "intake"
      },
      "save": {
        "a1": "activity"
      }
    },
    {
      "call": "records/v0.3/write",
      "body": {
        "caller": {
          "routine": "${a1}"
        },
        "type": "health_note",
        "content": {
          "text": "Dr. Lee: Dana's follow-up for the knee is on the 14th."
        },
        "provenance": {
          "source": "external",
          "relayed_by": "mail adapter (household-mail)",
          "trust": "untrusted"
        },
        "audience": {
          "members": [
            "dana"
          ]
        }
      },
      "save": {
        "note": "object"
      }
    },
    {
      "call": "egress/v0.2/disclose",
      "body": {
        "caller": {
          "routine": "${a1}"
        },
        "provider": "claude",
        "categories": [
          "general"
        ],
        "records": [
          "${note}"
        ],
        "content": "Summarise this mail."
      },
      "expect": {
        "refused": "category_not_allowed"
      }
    },
    {
      "call": "egress/v0.2/loosen",
      "body": {
        "caller": {
          "shell": "dana",
          "device": "dana-phone"
        },
        "activity": "${a1}",
        "categories": [
          "health"
        ]
      }
    },
    {
      "call": "egress/v0.2/disclose",
      "body": {
        "caller": {
          "routine": "${a1}"
        },
        "provider": "claude",
        "categories": [
          "general"
        ],
        "records": [
          "${note}"
        ],
        "content": "Summarise this mail."
      },
      "expect": {
        "ok": {
          "detail": {
            "provider": "claude",
            "categories": [
              "general",
              "health"
            ],
            "memory": "off"
          }
        }
      },
      "save": {
        "rid": "request_id"
      }
    }
  ],
  "expect_ledger": [
    {
      "kind": "refusal",
      "operation": "provider.disclose",
      "object": "provider:claude",
      "reason": {
        "code": "category_not_allowed"
      },
      "detail": {
        "about": {
          "categories": [
            "general",
            "health"
          ]
        }
      }
    },
    {
      "kind": "loosened",
      "activity": "${a1}",
      "source": {
        "kind": "principal",
        "id": "dana"
      },
      "detail": {
        "categories": [
          "health"
        ]
      }
    },
    {
      "kind": "consumption",
      "request_id": "${rid}",
      "operation": "provider.disclose"
    },
    {
      "kind": "disclosure",
      "request_id": "${rid}",
      "object": "provider:claude",
      "evidence": "acknowledged",
      "detail": {
        "provider": "claude",
        "categories": [
          "general",
          "health"
        ]
      },
      "authority": {
        "principal": "dana"
      }
    }
  ],
  "expect_mock": {
    "providers": {
      "claude": {
        "disclosure_count": 1
      }
    }
  }
}
