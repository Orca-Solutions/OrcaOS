{
  "app": "daybook",
  "name": "Daybook",
  "version": "0.1.0",
  "kind": "core",
  "surfaces": {
    "install": "0.3",
    "activities": "0.2",
    "grants": "0.2",
    "proposals": "0.3",
    "ledger": "0.1",
    "records": "0.3",
    "egress": "0.2",
    "members": "0.2",
    "schedules": "0.3",
    "household": "0.3"
  },
  "record_types": [
    {
      "name": "note"
    },
    {
      "name": "mail_item"
    },
    {
      "name": "health_note",
      "categories": [
        "health"
      ]
    }
  ],
  "routines": [
    {
      "name": "intake",
      "timeout_minutes": 30
    },
    {
      "name": "reply",
      "timeout_minutes": 60
    },
    {
      "name": "morning",
      "trigger": "schedule",
      "concurrency_key": "morning",
      "timeout_minutes": 30
    }
  ],
  "operations": [
    {
      "operation": "mail.read",
      "adapter": "mail",
      "object": "mail:household-mail",
      "grant": "standing"
    },
    {
      "operation": "mail.send",
      "adapter": "mail",
      "object": "mail:household-mail",
      "grant": "standing",
      "approval": "required"
    },
    {
      "operation": "provider.disclose",
      "adapter": "provider",
      "object": "provider:claude",
      "grant": "standing"
    }
  ],
  "providers": [
    {
      "name": "claude"
    }
  ],
  "disclosure_categories": [
    "general",
    "health"
  ],
  "notifications": {
    "kinds": [
      "digest"
    ],
    "per_day": 3
  }
}
